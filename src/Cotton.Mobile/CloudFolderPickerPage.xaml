<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Cotton.Mobile.Controls"
             xmlns:viewModels="clr-namespace:Cotton.Mobile.ViewModels"
             x:Class="Cotton.Mobile.CloudFolderPickerPage"
             x:Name="RootPage"
             x:DataType="viewModels:CloudFolderPickerViewModel"
             Shell.NavBarIsVisible="False"
             Title="Choose cloud folder">

    <controls:ScreenShellView>
        <controls:TopAppBar TitleText="Cloud folder"
                            BackCommand="{Binding CancelCommand}"
                            PrimaryIconData="{x:Static controls:IconPathData.Check}"
                            PrimaryCommand="{Binding ChooseCommand}"
                            PrimaryDescription="Use current cloud folder"
                            SecondaryIconData="{x:Static controls:IconPathData.ArrowUp}"
                            SecondaryCommand="{Binding UpCommand}"
                            SecondaryDescription="Go to parent folder"
                            IsSecondaryActionVisible="{Binding CanNavigateUp}" />

        <controls:ScreenContentGridView Grid.Row="1">
            <controls:ScreenHeaderView Title="{Binding CurrentFolderName}"
                                       SupportingText="{Binding PathText}"
                                       IsSupportingTextVisible="True"
                                       IsSupportingTextMultiline="True"
                                       IsBusy="{Binding IsBusy}" />

            <controls:ScreenStatusView Grid.Row="1"
                                       Text="{Binding Status}"
                                       IsStatusVisible="{Binding IsStatusVisible}" />

            <controls:EmptyStateView Grid.Row="2"
                                     IsStateVisible="{Binding IsEmptyVisible}"
                                     IconData="{x:Static controls:IconPathData.Folder}"
                                     Title="No subfolders"
                                     Body="Use this folder or go back."
                                     IsActionVisible="False" />

            <controls:MaterialCollectionView Grid.Row="2"
                                             IsContentVisible="{Binding IsListVisible}"
                                             ItemsSource="{Binding Folders}"
                                             ItemSizingStrategy="MeasureAllItems"
                                             ItemsLayout="{StaticResource M3VerticalCardListItemsLayout}">
                <controls:MaterialCollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:CloudFolderItemViewModel">
                        <controls:ContentCardView>
                            <controls:ActionListItemView Text="{Binding Name}"
                                                         LeadingIconData="{x:Static controls:IconPathData.Folder}"
                                                         IsLeadingIconVisible="True"
                                                         LeadingIconFrameStyleResourceKey="M3FolderThumbnailFrame"
                                                         ActionIconData="{x:Static controls:IconPathData.ChevronRight}"
                                                         Command="{Binding OpenCommand}"
                                                         GridStyleResourceKey="M3SettingsListItemGrid"
                                                         TextStyleResourceKey="M3SingleLineListItemTitle" />
                        </controls:ContentCardView>
                    </DataTemplate>
                </controls:MaterialCollectionView.ItemTemplate>
            </controls:MaterialCollectionView>
        </controls:ScreenContentGridView>
    </controls:ScreenShellView>
</ContentPage>
