<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Cotton.Mobile"
             xmlns:localization="clr-namespace:Cotton.Mobile.Resources.Localization"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:services="clr-namespace:Cotton.Mobile.Services;assembly=Cotton.Mobile.Core"
             xmlns:symbols="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             xmlns:viewModels="clr-namespace:Cotton.Mobile.ViewModels"
             x:Class="Cotton.Mobile.SyncRootSetupOptionsPage"
             x:DataType="viewModels:SyncRootSetupOptionsViewModel"
             Shell.NavBarIsVisible="False"
             Title="{x:Static localization:SyncRootSetupResources.PageTitle}">

    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource AppScreen}"
          InputTransparent="{Binding IsInteractionLocked}">
        <Grid ColumnDefinitions="Auto,*,Auto"
              Style="{StaticResource AppTopBar}">
            <Button Command="{Binding CancelCommand}"
                    SemanticProperties.Description="{x:Static localization:AppResources.BackDescription}"
                    StyleClass="TextButton, TouchTarget">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialOutlined"
                                     Glyph="{x:Static symbols:MaterialOutlined.Arrow_back}"
                                     Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Button.ImageSource>
            </Button>
            <Label Grid.Column="1"
                   Text="{x:Static localization:SyncRootSetupResources.AppBarTitle}"
                   Style="{StaticResource AppTopBarTitle}" />
            <Button Grid.Column="2"
                    Command="{Binding ContinueCommand}"
                    SemanticProperties.Description="{x:Static localization:SyncRootSetupResources.ContinueDescription}"
                    StyleClass="TextButton, TouchTarget, DisabledOpacity">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialOutlined"
                                     Glyph="{x:Static symbols:MaterialOutlined.Check}"
                                     Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Button.ImageSource>
            </Button>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Style="{StaticResource AppScrollableContent}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{x:Static localization:SyncRootSetupResources.Heading}"
                           Style="{StaticResource AppScreenTitle}" />
                    <Label Text="{x:Static localization:SyncRootSetupResources.SupportingText}"
                           Style="{StaticResource AppBodyText}" />
                </VerticalStackLayout>

                <VerticalStackLayout RadioButtonGroup.GroupName="SyncSource"
                                     RadioButtonGroup.SelectedValue="{Binding StorageKind, Mode=TwoWay}"
                                     Spacing="12">
                    <VerticalStackLayout Spacing="2">
                        <RadioButton AutomationId="SourceFolderOption"
                                     Content="{x:Static localization:SyncRootSetupResources.FolderTitle}"
                                     Value="{x:Static services:CottonSyncRootStorageKind.UserSelectedDocumentTree}"
                                     MinimumHeightRequest="48" />
                        <Label Text="{x:Static localization:SyncRootSetupResources.FolderSupportingText}"
                               Margin="35,0,0,0"
                               Style="{StaticResource AppBodyText}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="2">
                        <RadioButton AutomationId="SourceMediaOption"
                                     Content="{x:Static localization:SyncRootSetupResources.MediaTitle}"
                                     Value="{x:Static services:CottonSyncRootStorageKind.MediaStore}"
                                     MinimumHeightRequest="48" />
                        <Label Text="{x:Static localization:SyncRootSetupResources.MediaSupportingText}"
                               Margin="35,0,0,0"
                               Style="{StaticResource AppBodyText}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <local:MediaLocationAccessView BindingContext="{Binding MediaLocationAccess}" />

                <Border IsVisible="{Binding IsDeleteOptionVisible}"
                        Style="{StaticResource AppCard}">
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3"
                                             VerticalOptions="Center">
                            <Label Text="{x:Static localization:SyncRootSetupResources.DeleteOriginalsTitle}"
                                   FontAttributes="Bold" />
                            <Label Text="{x:Static localization:SyncRootSetupResources.DeleteOriginalsSupportingText}"
                                   Style="{StaticResource AppBodyText}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding DeleteOriginalsAfterUpload}"
                                SemanticProperties.Description="{x:Static localization:SyncRootSetupResources.DeleteOriginalsTitle}"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
