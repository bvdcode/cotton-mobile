<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Cotton.Mobile.Controls">
    <Style TargetType="Border" x:Key="M3AuthPanel">
        <Setter Property="Stroke" Value="{StaticResource M3Transparent}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{StaticResource M3AuthPanelCornerRadius}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="{StaticResource M3StrokeNone}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightSurfaceContainerLow}, Dark={StaticResource M3DarkSurfaceContainerLow}}" />
        <Setter Property="Padding" Value="{StaticResource M3AuthPanelPadding}" />
        <Setter Property="MaximumWidthRequest" Value="{StaticResource M3AuthPanelMaxWidth}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style TargetType="Border" x:Key="M3AuthPanelFlat">
        <Setter Property="Stroke" Value="{StaticResource M3Transparent}" />
        <Setter Property="StrokeThickness" Value="{StaticResource M3StrokeNone}" />
        <Setter Property="BackgroundColor" Value="{StaticResource M3Transparent}" />
        <Setter Property="Padding" Value="{StaticResource M3AuthPanelFlatPadding}" />
        <Setter Property="MaximumWidthRequest" Value="{StaticResource M3AuthPanelMaxWidth}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style TargetType="VerticalStackLayout" x:Key="M3AuthShellStack">
        <Setter Property="Spacing" Value="{StaticResource Space20}" />
        <Setter Property="Margin" Value="{StaticResource M3AuthShellMargin}" />
        <Setter Property="MaximumWidthRequest" Value="{StaticResource M3AuthPanelMaxWidth}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style TargetType="controls:AuthLegalFooterView" x:Key="M3AuthLegalFooterContainer">
        <Setter Property="Margin" Value="{StaticResource M3AuthLegalFooterMargin}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="End" />
    </Style>

    <Style TargetType="Grid" x:Key="M3AuthBrandGrid">
        <Setter Property="RowSpacing" Value="{StaticResource Space12}" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style TargetType="Image" x:Key="M3AuthBrandMarkImage">
        <Setter Property="WidthRequest" Value="{StaticResource M3AuthBrandMarkImageSize}" />
        <Setter Property="HeightRequest" Value="{StaticResource M3AuthBrandMarkImageSize}" />
        <Setter Property="Aspect" Value="AspectFit" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="M3AuthTitle" BasedOn="{StaticResource M3TitleLarge}">
        <Setter Property="FontFamily" Value="{StaticResource M3FontFamilyMedium}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Border" x:Key="M3AuthBrandMarkFrame">
        <Setter Property="WidthRequest" Value="{StaticResource M3AuthBrandMarkFrameSize}" />
        <Setter Property="HeightRequest" Value="{StaticResource M3AuthBrandMarkFrameSize}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource M3LightOutlineVariant}, Dark={StaticResource M3DarkOutlineVariant}}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{StaticResource ShapeExtraLarge}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="{StaticResource M3StrokeThin}" />
        <Setter Property="BackgroundColor" Value="{StaticResource M3BrandSurface}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="VerticalStackLayout" x:Key="M3AuthFormStack">
        <Setter Property="Spacing" Value="{StaticResource Space16}" />
    </Style>

    <Style TargetType="VerticalStackLayout" x:Key="M3AuthActionStack">
        <Setter Property="Spacing" Value="{StaticResource Space4}" />
    </Style>

    <Style TargetType="Grid" x:Key="M3MainPageRootGrid">
        <Setter Property="Padding" Value="{StaticResource M3MainPagePadding}" />
    </Style>

    <Style TargetType="VerticalStackLayout" x:Key="M3MainContentStack">
        <Setter Property="Spacing" Value="{StaticResource Space24}" />
        <Setter Property="Padding" Value="{StaticResource M3MainContentBottomPadding}" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>


</ResourceDictionary>
