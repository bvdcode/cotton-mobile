<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <IsBindingProject>true</IsBindingProject>
    <AssemblyName>Xamarin.AndroidX.Work.Runtime</AssemblyName>
    <RootNamespace>AndroidX.Work</RootNamespace>
    <PackageId>Xamarin.AndroidX.Work.Runtime</PackageId>
    <PackageVersion>2.12.0-cotton.1</PackageVersion>
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <Description>Android binding for WorkManager 2.12.0.</Description>
    <RepositoryUrl>https://github.com/dotnet/android-libraries</RepositoryUrl>
    <AndroidBoundInterfacesContainStaticAndDefaultInterfaceMethods>true</AndroidBoundInterfacesContainStaticAndDefaultInterfaceMethods>
    <AndroidBoundInterfacesContainConstants>false</AndroidBoundInterfacesContainConstants>
    <AndroidBoundInterfacesContainTypes>false</AndroidBoundInterfacesContainTypes>
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <Deterministic>true</Deterministic>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RepositoryCommit>06ad7c36ce57951634ded2551e64811f5a7c99b3</RepositoryCommit>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <PathMap>$(MSBuildProjectDirectory)=/_/</PathMap>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <AndroidNamespaceReplacement Include="androidx." Replacement="AndroidX" />
    <AndroidLibrary Include="work-runtime-2.12.0.aar" Bind="true" />
    <Compile Include="source_androidx.work_work-runtime_Additions_WorkAdditions.cs" />
    <TransformFile Include="source_Metadata.common.xml" />
    <TransformFile Include="source_androidx.work_work-runtime_Transforms_Metadata.xml" />
    <PackageReference Include="Xamarin.AndroidX.Annotation.Experimental" Version="1.5.1.1" />
    <PackageReference Include="Xamarin.AndroidX.Concurrent.Futures.Ktx" Version="1.3.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="1.16.0.3" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.9.2.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Service" Version="2.9.2.1" />
    <PackageReference Include="Xamarin.AndroidX.Room.Runtime" Version="2.7.2.1" />
    <PackageReference Include="Xamarin.AndroidX.Startup.StartupRuntime" Version="1.2.0.5" />
    <PackageReference Include="Xamarin.AndroidX.Tracing.Tracing.Ktx" Version="1.3.0.1" />
    <PackageReference Include="Xamarin.Google.Guava.ListenableFuture" Version="1.0.0.29" />
    <PackageReference Include="Xamarin.JSpecify" Version="1.0.0.4" />
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="2.2.0.1" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.10.2.1" />
    <None Include="LICENSE.TXT" Pack="true" PackagePath="upstream-binding-LICENSE.txt" />
  </ItemGroup>
</Project>
