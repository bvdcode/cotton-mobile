<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Cotton.Mobile.Controls"
             xmlns:local="clr-namespace:Cotton.Mobile"
             xmlns:viewModels="clr-namespace:Cotton.Mobile.ViewModels"
             x:Class="Cotton.Mobile.MainPage"
             x:Name="RootPage"
             x:DataType="viewModels:MainPageViewModel"
             Shell.NavBarIsVisible="False">

    <controls:MainPageRootView>
        <controls:ScreenScrollBodyView Grid.Row="0"
                                       IsContentVisible="{Binding Display.IsBrandHeaderVisible}"
                                       StackStyleResourceKey="M3MainContentStack">
            <controls:StackedContentView IsContentVisible="{Binding Display.IsBrandHeaderVisible}"
                                         StackStyleResourceKey="M3AuthShellStack">
                <controls:BrandHeaderView Source="cotton_brand_mark.svg"
                                          Title="Cotton Cloud"
                                          SemanticDescription="Cotton Cloud" />

                <controls:LoadingStatusView IsStatusVisible="{Binding Display.IsLoadingVisible}"
                                            IsRunning="{Binding Display.IsLoadingIndicatorRunning}"
                                            Text="{Binding Display.LoadingMessage}"
                                            ContainerStyleResourceKey="M3AuthLoadingStatusPanel" />

                <controls:AuthSignInPanelView IsPanelVisible="{Binding Display.IsSignInVisible}"
                                              InstanceUrl="{Binding Display.InstanceUrl, Mode=TwoWay}"
                                              Placeholder="{Binding Display.InstanceUrlPlaceholder}"
                                              Status="{Binding Display.Status}"
                                              IsStatusVisible="{Binding Display.IsStatusVisible}"
                                              IsInputEnabled="{Binding Display.IsInputEnabled}"
                                              ConnectCommand="{Binding ConnectCommand}" />

                <controls:LoadingStatusView IsStatusVisible="{Binding Display.IsAuthorizationProgressVisible}"
                                            IsRunning="{Binding Display.IsAuthorizationProgressIndicatorRunning}"
                                            Text="Waiting for browser approval"
                                            DetailText="{Binding Display.AuthorizationProgressMessage}"
                                            ActionIconData="{x:Static controls:IconPathData.Close}"
                                            ActionCommand="{Binding CancelAuthorizationCommand}"
                                            IsActionEnabled="{Binding Display.IsCancelAuthorizationEnabled}"
                                            IsActionVisible="True"
                                            ActionSemanticDescription="Cancel browser approval"
                                            ContainerStyleResourceKey="M3AuthLoadingStatusPanel"
                                            TextStyleResourceKey="M3CardSupportingStrong" />
            </controls:StackedContentView>
        </controls:ScreenScrollBodyView>

        <controls:AuthLegalFooterView Grid.Row="0"
                                      IsFooterVisible="{Binding Display.IsLegalFooterVisible}"
                                      PrivacyCommand="{Binding PrivacyPolicyCommand}" />

        <Grid Grid.RowSpan="2"
              IsVisible="{Binding Display.IsAuthenticatedVisible}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <local:SyncDashboardView Grid.Row="0"
                                     BindingContext="{Binding Sync}"
                                     IsVisible="{Binding Display.IsSyncDestinationVisible, Source={x:Reference RootPage}}" />

            <local:ProfileView Grid.Row="0"
                               IsVisible="{Binding Display.IsProfileDestinationVisible}" />

            <controls:AppNavigationBarView Grid.Row="1"
                                           SelectedDestination="{Binding Display.SelectedDestination}"
                                           SyncCommand="{Binding ShowSyncCommand}"
                                           ProfileCommand="{Binding ShowProfileCommand}" />
        </Grid>
    </controls:MainPageRootView>
</ContentPage>
