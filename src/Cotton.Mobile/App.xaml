<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:material="clr-namespace:UraniumUI.Material.Resources;assembly=UraniumUI.Material"
             x:Class="Cotton.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary x:Name="appColors" Source="Resources/Styles/Colors.xaml" />
                <material:StyleResource ColorsOverride="{x:Reference appColors}" />
                <ResourceDictionary Source="Resources/Styles/Theme/MColors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Theme/MSpacing.xaml" />
                <ResourceDictionary Source="Resources/Styles/Theme/MShape.xaml" />
                <ResourceDictionary Source="Resources/Styles/Theme/MElevation.xaml" />
                <ResourceDictionary Source="Resources/Styles/Theme/MInteraction.xaml" />
                <ResourceDictionary Source="Resources/Styles/Theme/MType.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/MFramework.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
