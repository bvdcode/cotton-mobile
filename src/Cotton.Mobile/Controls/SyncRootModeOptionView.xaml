<?xml version="1.0" encoding="utf-8" ?>
<controls:CommandPressableContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                                      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                                      xmlns:controls="clr-namespace:Cotton.Mobile.Controls"
                                      x:Class="Cotton.Mobile.Controls.SyncRootModeOptionView"
                                      x:Name="Root"
                                      x:DataType="controls:SyncRootModeOptionView">
    <Border Style="{StaticResource M3TonalPanel}"
            Padding="{StaticResource M3ContentCardPadding}"
            HorizontalOptions="Fill"
            BackgroundColor="{AppThemeBinding Light={StaticResource M3LightSurfaceContainerLow}, Dark={StaticResource M3DarkSurfaceContainerLow}}">
        <Border.Triggers>
            <DataTrigger TargetType="Border"
                         Binding="{Binding Source={x:Reference Root}, Path=IsSelected}"
                         Value="True">
                <Setter Property="Stroke"
                        Value="{AppThemeBinding Light={StaticResource M3LightPrimary}, Dark={StaticResource M3DarkAction}}" />
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource M3LightPrimaryContainer}, Dark={StaticResource M3DarkActionContainer}}" />
            </DataTrigger>
        </Border.Triggers>

        <Grid ColumnSpacing="{StaticResource Space12}"
              VerticalOptions="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:IconFrame IconData="{Binding Source={x:Reference Root}, Path=IconData}"
                                Style="{StaticResource M3NeutralThumbnailFrame}"
                                VerticalOptions="Center" />

            <VerticalStackLayout Grid.Column="1"
                                 Style="{StaticResource M3CardTextStack}"
                                 VerticalOptions="Center">
                <Label Text="{Binding Source={x:Reference Root}, Path=Title}"
                       Style="{StaticResource M3CardTitle}" />
                <Label Text="{Binding Source={x:Reference Root}, Path=SupportingText}"
                       Style="{StaticResource M3BodyMedium}" />
            </VerticalStackLayout>

            <Border Grid.Column="2"
                    WidthRequest="{StaticResource M3FileSelectionMarkSize}"
                    HeightRequest="{StaticResource M3FileSelectionMarkSize}"
                    Stroke="{AppThemeBinding Light={StaticResource M3LightOutline}, Dark={StaticResource M3DarkOutline}}"
                    StrokeThickness="{StaticResource M3StrokeThin}"
                    BackgroundColor="{StaticResource M3Transparent}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource ShapeFull}" />
                </Border.StrokeShape>
                <Border.Triggers>
                    <DataTrigger TargetType="Border"
                                 Binding="{Binding Source={x:Reference Root}, Path=IsSelected}"
                                 Value="True">
                        <Setter Property="Stroke"
                                Value="{AppThemeBinding Light={StaticResource M3LightPrimary}, Dark={StaticResource M3DarkAction}}" />
                        <Setter Property="BackgroundColor"
                                Value="{AppThemeBinding Light={StaticResource M3LightPrimary}, Dark={StaticResource M3DarkAction}}" />
                    </DataTrigger>
                </Border.Triggers>

                <controls:IconView IconData="{x:Static controls:IconPathData.Check}"
                                   IconColor="{AppThemeBinding Light={StaticResource M3LightOnPrimary}, Dark={StaticResource M3DarkOnAction}}"
                                   IconSize="{StaticResource M3FileSelectionIconSize}"
                                   Opacity="0">
                    <controls:IconView.Triggers>
                        <DataTrigger TargetType="controls:IconView"
                                     Binding="{Binding Source={x:Reference Root}, Path=IsSelected}"
                                     Value="True">
                            <Setter Property="Opacity" Value="1" />
                        </DataTrigger>
                    </controls:IconView.Triggers>
                </controls:IconView>
            </Border>
        </Grid>
    </Border>
</controls:CommandPressableContentView>
