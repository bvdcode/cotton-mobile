<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Cotton.Mobile"
             xmlns:localization="clr-namespace:Cotton.Mobile.Resources.Localization"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:symbols="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             xmlns:viewModels="clr-namespace:Cotton.Mobile.ViewModels"
             x:Class="Cotton.Mobile.MainPage"
             x:Name="RootPage"
             x:DataType="viewModels:MainPageViewModel"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto"
          Style="{StaticResource AppScreen}">
        <ScrollView Grid.Row="0"
                    IsVisible="{Binding Display.IsBrandHeaderVisible}">
            <VerticalStackLayout Style="{StaticResource AppScrollableContent}"
                                 Padding="24,48,24,24">
                <VerticalStackLayout Spacing="16"
                                     HorizontalOptions="Center">
                    <Border WidthRequest="104"
                            HeightRequest="104"
                            Padding="12"
                            BackgroundColor="{StaticResource BackgroundDark}"
                            Stroke="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}"
                            StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>
                        <Image Source="cotton_brand_mark.svg"
                               SemanticProperties.Description="{x:Static localization:AppResources.AppTitle}" />
                    </Border>
                    <Label Text="{x:Static localization:AppResources.AppTitle}"
                           Style="{StaticResource AppScreenTitle}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding Display.IsLoadingVisible}"
                                     Spacing="12"
                                     HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding Display.IsLoadingIndicatorRunning}"
                                       IsVisible="{Binding Display.IsLoadingIndicatorRunning}"
                                       Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label Text="{Binding Display.LoadingMessage}"
                           Style="{StaticResource AppBodyText}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding Display.IsSignInVisible}"
                                     Spacing="16">
                    <material:TextField Title="{Binding Display.InstanceUrlPlaceholder}"
                                        Text="{Binding Display.InstanceUrl, Mode=TwoWay}"
                                        Keyboard="Url"
                                        ReturnType="Go"
                                        ReturnCommand="{Binding ConnectCommand}"
                                        AllowClear="True"
                                        IsEnabled="{Binding Display.IsInputEnabled}"
                                        SemanticProperties.Hint="{x:Static localization:AppResources.CottonCloudAddressHint}"
                                        Icon="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static symbols:MaterialOutlined.Cloud}, Color={AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}}" />

                    <Label Text="{Binding Display.Status}"
                           IsVisible="{Binding Display.IsStatusVisible}"
                           Style="{StaticResource AppBodyText}" />

                    <Button Text="{x:Static localization:AppResources.ConnectText}"
                            Command="{Binding ConnectCommand}"
                            IsEnabled="{Binding Display.IsInputEnabled}"
                            StyleClass="FilledButton, TouchTarget" />
                </VerticalStackLayout>

                <Border IsVisible="{Binding Display.IsAuthorizationProgressVisible}"
                        Style="{StaticResource AppStatusCard}">
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">
                        <ActivityIndicator IsRunning="{Binding Display.IsAuthorizationProgressIndicatorRunning}"
                                           Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="4"
                                             VerticalOptions="Center">
                            <Label Text="{x:Static localization:AppResources.WaitingForBrowserApproval}"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding Display.AuthorizationProgressMessage}"
                                   Style="{StaticResource AppBodyText}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2"
                                Text="{x:Static localization:AppResources.CancelText}"
                                Command="{Binding CancelAuthorizationCommand}"
                                IsEnabled="{Binding Display.IsCancelAuthorizationEnabled}"
                                SemanticProperties.Description="{x:Static localization:AppResources.CancelBrowserApprovalDescription}"
                                StyleClass="TextButton, TouchTarget" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="1"
                               Margin="12,4"
                               Spacing="4"
                               IsVisible="{Binding Display.IsLegalFooterVisible}"
                               HorizontalOptions="Center">
            <Button Text="{x:Static localization:AppResources.RepositoryText}"
                    Command="{Binding OpenRepositoryCommand}"
                    StyleClass="TextButton, TouchTarget" />
            <BoxView WidthRequest="1"
                     HeightRequest="20"
                     VerticalOptions="Center"
                     Color="{AppThemeBinding Light={StaticResource OutlineVariant}, Dark={StaticResource OutlineVariantDark}}" />
            <Button Text="{x:Static localization:AppResources.PrivacyText}"
                    Command="{Binding PrivacyPolicyCommand}"
                    StyleClass="TextButton, TouchTarget" />
        </HorizontalStackLayout>

        <Grid Grid.RowSpan="2"
              RowDefinitions="*,Auto"
              IsVisible="{Binding Display.IsAuthenticatedVisible}">
            <local:SyncDashboardView Grid.Row="0"
                                     BindingContext="{Binding Sync}"
                                     IsVisible="{Binding BindingContext.Display.IsSyncDestinationVisible, Source={x:Reference RootPage}}" />

            <local:ProfileView Grid.Row="0"
                               IsVisible="{Binding Display.IsProfileDestinationVisible}" />

            <Grid Grid.Row="1"
                  ColumnDefinitions="*,*"
                  Style="{StaticResource AppNavigationBar}">
                <Button Text="{x:Static localization:AppResources.SyncTitle}"
                        Command="{Binding ShowSyncCommand}"
                        ContentLayout="Top,4"
                        SemanticProperties.Description="{x:Static localization:AppResources.RunAllSyncFoldersDescription}"
                        StyleClass="TextButton, NavigationBarItem">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialOutlined"
                                         Glyph="{x:Static symbols:MaterialOutlined.Sync_alt}"
                                         Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Button.ImageSource>
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Display.IsSyncDestinationVisible}"
                                     Value="True">
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource PrimaryContainer}, Dark={StaticResource PrimaryContainerDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>

                <Button Grid.Column="1"
                        Text="{x:Static localization:AppResources.ProfileTitle}"
                        Command="{Binding ShowProfileCommand}"
                        ContentLayout="Top,4"
                        SemanticProperties.Description="{x:Static localization:AppResources.OpenProfileDescription}"
                        StyleClass="TextButton, NavigationBarItem">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialOutlined"
                                         Glyph="{x:Static symbols:MaterialOutlined.Account_circle}"
                                         Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Button.ImageSource>
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Display.IsProfileDestinationVisible}"
                                     Value="True">
                            <Setter Property="BackgroundColor"
                                    Value="{AppThemeBinding Light={StaticResource PrimaryContainer}, Dark={StaticResource PrimaryContainerDark}}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
