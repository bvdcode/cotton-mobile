root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,xaml}]
indent_style = space
indent_size = 4

[*.cs]
csharp_style_namespace_declarations = block_scoped:error
csharp_style_prefer_primary_constructors = true:warning
csharp_style_var_elsewhere = false:warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning

# EasyExtensions analyzers
dotnet_code_quality.EEX0001.max_lines = 300
dotnet_diagnostic.EEX0001.severity = error
dotnet_diagnostic.EEX0002.severity = error
dotnet_diagnostic.EEX0003.severity = error
dotnet_diagnostic.EEX0004.severity = error
dotnet_diagnostic.EEX0005.severity = error
dotnet_diagnostic.EEX0006.severity = error
dotnet_diagnostic.EEX0007.severity = error
dotnet_diagnostic.EEX0008.severity = error
dotnet_diagnostic.EEX0009.severity = error
dotnet_diagnostic.EEX0010.severity = error
dotnet_diagnostic.EEX0011.severity = error
dotnet_diagnostic.EEX0012.severity = error
dotnet_diagnostic.EEX0013.severity = error
dotnet_diagnostic.EEX0014.severity = error

# Project policy intentionally keeps types extensible and prohibits sealed declarations.
dotnet_diagnostic.CA1852.severity = none
[*.{csproj,props,targets}]
indent_style = tab
indent_size = 4

[*.{yml,yaml,json,md,py,sh}]
indent_style = space
indent_size = 2
