<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:Cotton.Mobile.Resources.Localization"
             xmlns:services="clr-namespace:Cotton.Mobile.Services;assembly=Cotton.Mobile.Core"
             xmlns:symbols="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             xmlns:viewModels="clr-namespace:Cotton.Mobile.ViewModels"
             x:Class="Cotton.Mobile.SyncDashboardView"
             x:Name="SyncViewRoot"
             x:DataType="viewModels:SyncSettingsViewModel">

    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource AppScreen}">
        <Grid ColumnDefinitions="*,Auto"
              Style="{StaticResource AppTopBar}">
            <Label Text="{Binding TopBarTitle}"
                   Style="{StaticResource AppTopBarTitle}" />

            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="0"
                                   HorizontalOptions="End">
                <Button Command="{Binding AddRootCommand}"
                        IsVisible="{Binding ArePrimaryActionsVisible}"
                        WidthRequest="{StaticResource AppTouchTargetSize}"
                        Padding="0"
                        SemanticProperties.Description="{x:Static localization:AppResources.AddSyncFolderDescription}"
                        StyleClass="TextButton, TouchTarget">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialOutlined"
                                         Glyph="{x:Static symbols:MaterialOutlined.Add}"
                                         Size="{StaticResource AppActionIconSize}"
                                         Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Button.ImageSource>
                </Button>

                <Button Command="{Binding RunAllCommand}"
                        IsVisible="{Binding IsRunAllVisible}"
                        WidthRequest="{StaticResource AppTouchTargetSize}"
                        Padding="0"
                        SemanticProperties.Description="{x:Static localization:AppResources.RunAllSyncFoldersDescription}"
                        StyleClass="TextButton, TouchTarget">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialOutlined"
                                         Glyph="{x:Static symbols:MaterialOutlined.Play_arrow}"
                                         Size="{StaticResource AppActionIconSize}"
                                         Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Button.ImageSource>
                </Button>

                <Button Command="{Binding EnterEditModeCommand}"
                        IsVisible="{Binding IsEditModeAvailable}"
                        WidthRequest="{StaticResource AppTouchTargetSize}"
                        Padding="0"
                        SemanticProperties.Description="{x:Static localization:AppResources.EnterEditSyncsModeDescription}"
                        StyleClass="TextButton, TouchTarget">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialOutlined"
                                         Glyph="{x:Static symbols:MaterialOutlined.Edit}"
                                         Size="{StaticResource AppEditActionIconSize}"
                                         Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Button.ImageSource>
                </Button>

                <Button Command="{Binding ExitEditModeCommand}"
                        IsVisible="{Binding IsEditMode}"
                        WidthRequest="{StaticResource AppTouchTargetSize}"
                        Padding="0"
                        SemanticProperties.Description="{x:Static localization:AppResources.ExitEditSyncsModeDescription}"
                        StyleClass="TextButton, TouchTarget">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="MaterialOutlined"
                                         Glyph="{x:Static symbols:MaterialOutlined.Close}"
                                         Size="{StaticResource AppActionIconSize}"
                                         Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    </Button.ImageSource>
                </Button>
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              Padding="{StaticResource AppPagePadding}"
              MaximumWidthRequest="{StaticResource AppContentMaximumWidth}"
              HorizontalOptions="Fill">
            <Border IsVisible="{Binding BackgroundRestriction.IsVisible}"
                    Padding="12,8"
                    Margin="0,0,0,8"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SecondaryContainer}, Dark={StaticResource SecondaryContainerDark}}"
                    StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="12">
                    <Image WidthRequest="24"
                           HeightRequest="24"
                           VerticalOptions="Center"
                           Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static symbols:MaterialOutlined.Sync_alt}, Color={AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}}" />
                    <Label Grid.Column="1"
                           Text="{x:Static localization:AppResources.BackgroundSyncRestrictedMessage}"
                           Style="{StaticResource AppBodyText}"
                           TextColor="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}"
                           VerticalOptions="Center" />
                    <Button Grid.Column="2"
                            Text="{x:Static localization:AppResources.BackgroundSyncSettingsText}"
                            Command="{Binding BackgroundRestriction.OpenSettingsCommand}"
                            SemanticProperties.Description="{x:Static localization:AppResources.OpenBackgroundSyncSettingsDescription}"
                            StyleClass="TextButton, TouchTarget" />
                </Grid>
            </Border>

            <VerticalStackLayout Grid.Row="1"
                                 Spacing="16"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 IsVisible="{Binding IsEmptyVisible}">
                <Border Style="{StaticResource AppIconFrame}"
                        HorizontalOptions="Center">
                    <Image Style="{StaticResource AppIcon}"
                           Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static symbols:MaterialOutlined.Folder}, Color={AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}}" />
                </Border>
                <Label Text="{x:Static localization:AppResources.NoSyncFoldersTitle}"
                       Style="{StaticResource AppSectionTitle}"
                       HorizontalTextAlignment="Center" />
                <Label Text="{x:Static localization:AppResources.NoSyncFoldersBody}"
                       Style="{StaticResource AppBodyText}"
                       HorizontalTextAlignment="Center" />
                <Button Text="{x:Static localization:AppResources.AddSyncFolderDescription}"
                        Command="{Binding AddRootCommand}"
                        StyleClass="FilledButton, TouchTarget" />
            </VerticalStackLayout>

            <CollectionView Grid.Row="1"
                            IsVisible="{Binding IsListVisible}"
                            ItemsSource="{Binding Roots}"
                            ItemSizingStrategy="MeasureAllItems">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="0" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:CottonSyncRootListItem">
                        <Grid RowDefinitions="Auto,Auto">
                            <VerticalStackLayout Padding="4,10"
                                                 Spacing="8">
                                <Grid ColumnSpacing="12"
                                      IsClippedToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{StaticResource AppTouchTargetSize}" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource AppIconFrame}">
                                        <Image Style="{StaticResource AppIcon}">
                                            <Image.Source>
                                                <FontImageSource FontFamily="MaterialOutlined"
                                                                 Glyph="{x:Static symbols:MaterialOutlined.Folder}"
                                                                 Color="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}" />
                                            </Image.Source>
                                            <Image.Triggers>
                                                <DataTrigger TargetType="Image"
                                                             Binding="{Binding UsesMediaStore}"
                                                             Value="True">
                                                    <Setter Property="Source"
                                                            Value="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static symbols:MaterialOutlined.Photo_library}, Color={AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Image"
                                                             Binding="{Binding IsAttentionVisible}"
                                                             Value="True">
                                                    <Setter Property="Source"
                                                            Value="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static symbols:MaterialOutlined.Error}, Color={AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}}" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>
                                    </Border>

                                    <Grid Grid.Column="1"
                                          RowDefinitions="Auto,Auto"
                                          RowSpacing="3"
                                          IsClippedToBounds="True"
                                          VerticalOptions="Center">
                                        <Label Text="{Binding DisplayPathText}"
                                               FontAttributes="Bold"
                                               Style="{StaticResource AppBodyText}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Grid Grid.Row="1"
                                              IsClippedToBounds="True">
                                            <Label
                                                   Text="{Binding StatusText}"
                                                   Style="{StaticResource AppBodyText}"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"
                                                   VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding CanUseStatusAction}"
                                                                 Value="True">
                                                        <Setter Property="IsVisible" Value="False" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <Button
                                                    Text="{Binding StatusText}"
                                                    Command="{Binding BindingContext.RootActionCommand, Source={x:Reference SyncViewRoot}}"
                                                    CommandParameter="{Binding StatusAction}"
                                                    SemanticProperties.Description="{Binding StatusActionText}"
                                                    HorizontalOptions="Start"
                                                    Padding="0"
                                                    IsVisible="False"
                                                    StyleClass="TextButton, TouchTarget">
                                                <Button.Triggers>
                                                    <DataTrigger TargetType="Button"
                                                                 Binding="{Binding CanUseStatusAction}"
                                                                 Value="True">
                                                        <Setter Property="IsVisible" Value="True" />
                                                    </DataTrigger>
                                                </Button.Triggers>
                                            </Button>
                                        </Grid>
                                    </Grid>

                                    <Button Grid.Column="2"
                                            Command="{Binding BindingContext.RootActionCommand, Source={x:Reference SyncViewRoot}}"
                                            CommandParameter="{Binding PauseResumeAction}"
                                            IsVisible="{Binding BindingContext.ArePrimaryActionsVisible, Source={x:Reference SyncViewRoot}}"
                                            SemanticProperties.Description="{Binding PauseResumeActionText}"
                                            WidthRequest="{StaticResource AppTouchTargetSize}"
                                            Padding="0"
                                            StyleClass="TextButton, TouchTarget">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="MaterialOutlined"
                                                             Glyph="{x:Static symbols:MaterialOutlined.Pause}"
                                                             Color="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
                                        </Button.ImageSource>
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button"
                                                         Binding="{Binding PauseResumeAction.Action}"
                                                         Value="{x:Static services:CottonSyncRootAction.Resume}">
                                                <Setter Property="ImageSource"
                                                        Value="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static symbols:MaterialOutlined.Play_arrow}, Color={AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}}" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                    </Button>

                                    <Button Grid.Column="2"
                                            Command="{Binding BindingContext.RootActionCommand, Source={x:Reference SyncViewRoot}}"
                                            CommandParameter="{Binding DeleteAction}"
                                            IsEnabled="{Binding CanDeleteSync}"
                                            IsVisible="{Binding BindingContext.IsEditMode, Source={x:Reference SyncViewRoot}}"
                                            SemanticProperties.Description="{Binding DeleteSyncActionText}"
                                            WidthRequest="{StaticResource AppTouchTargetSize}"
                                            Padding="0"
                                            StyleClass="TextButton, TouchTarget">
                                        <Button.ImageSource>
                                            <FontImageSource FontFamily="MaterialOutlined"
                                                             Glyph="{x:Static symbols:MaterialOutlined.Delete}"
                                                             Color="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                                        </Button.ImageSource>
                                    </Button>
                                </Grid>

                                <ProgressBar Progress="{Binding ProgressValue}"
                                             IsVisible="{Binding IsProgressDeterminate}"
                                             Margin="60,0"
                                             ProgressColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                            </VerticalStackLayout>
                            <BoxView Grid.Row="1"
                                     Style="{StaticResource AppDivider}"
                                     IsVisible="{Binding IsDividerVisible}"
                                     />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentView>
