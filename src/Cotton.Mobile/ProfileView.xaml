<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Cotton.Mobile.Controls"
             xmlns:localization="clr-namespace:Cotton.Mobile.Resources.Localization"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:symbols="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             xmlns:viewModels="clr-namespace:Cotton.Mobile.ViewModels"
             x:Class="Cotton.Mobile.ProfileView"
             x:DataType="viewModels:MainPageViewModel">

    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource AppScreen}">
        <Grid ColumnDefinitions="*"
              Style="{StaticResource AppTopBar}">
            <Label Text="{x:Static localization:AppResources.ProfileTitle}"
                   Style="{StaticResource AppTopBarTitle}" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Style="{StaticResource AppScrollableContent}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{x:Static localization:AppResources.AccountTitle}"
                           Style="{StaticResource AppScreenTitle}" />
                    <Label Text="{x:Static localization:AppResources.AccountSupportingText}"
                           Style="{StaticResource AppBodyText}" />
                </VerticalStackLayout>

                <Label Text="{Binding Display.ProfileStatus}"
                       IsVisible="{Binding Display.IsProfileStatusVisible}"
                       Style="{StaticResource AppBodyText}" />

                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12"
                          Padding="4,12">
                        <Grid>
                            <Border Style="{StaticResource AppIconFrame}">
                                <Image Style="{StaticResource AppIcon}"
                                       Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static symbols:MaterialOutlined.Account_circle}, Color={AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}}" />
                            </Border>
                            <Border Style="{StaticResource AppAvatarFrame}">
                                <controls:ProfileAvatarImage Source="{Binding Display.ProfileAvatarUrl}"
                                                             Aspect="AspectFill">
                                    <controls:ProfileAvatarImage.Triggers>
                                        <Trigger TargetType="controls:ProfileAvatarImage"
                                                 Property="IsLoadedSuccessfully"
                                                 Value="False">
                                            <Setter Property="Opacity" Value="0" />
                                        </Trigger>
                                    </controls:ProfileAvatarImage.Triggers>
                                </controls:ProfileAvatarImage>
                            </Border>
                        </Grid>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3"
                                             VerticalOptions="Center">
                            <Label Text="{Binding Display.ProfileName}"
                                   Style="{StaticResource AppSectionTitle}" />
                            <Label Text="{Binding Display.ProfileEmail}"
                                   Style="{StaticResource AppBodyText}" />
                            <Label Text="{Binding Display.ProfileInstance}"
                                   Style="{StaticResource AppCaptionText}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView Style="{StaticResource AppDivider}" />

                    <material:ButtonView TappedCommand="{Binding PrivacyPolicyCommand}"
                                         Padding="4,12"
                                         StrokeThickness="0"
                                         BackgroundColor="Transparent"
                                         SemanticProperties.Description="{x:Static localization:AppResources.OpenPrivacyPolicyDescription}">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12">
                            <Border Style="{StaticResource AppIconFrame}">
                                <Image Style="{StaticResource AppIcon}"
                                       Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static symbols:MaterialOutlined.Open_in_new}, Color={AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="{x:Static localization:AppResources.PrivacyPolicyText}"
                                       FontAttributes="Bold" />
                                <Label Text="{x:Static localization:AppResources.PrivacyPolicySupportingText}"
                                       Style="{StaticResource AppBodyText}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2"
                                   Style="{StaticResource AppIcon}"
                                   Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static symbols:MaterialOutlined.Chevron_right}, Color={AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}}" />
                        </Grid>
                    </material:ButtonView>

                    <BoxView Style="{StaticResource AppDivider}" />

                    <material:ButtonView TappedCommand="{Binding LogoutCommand}"
                                         IsEnabled="{Binding IsLogoutEnabled}"
                                         Padding="4,12"
                                         StrokeThickness="0"
                                         BackgroundColor="Transparent"
                                         SemanticProperties.Description="{x:Static localization:AppResources.SignOutText}">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Border Style="{StaticResource AppIconFrame}">
                                <Image Style="{StaticResource AppIcon}"
                                       Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static symbols:MaterialOutlined.Close}, Color={AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3"
                                                 VerticalOptions="Center">
                                <Label Text="{x:Static localization:AppResources.SignOutText}"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                                <Label Text="{x:Static localization:AppResources.SignOutSupportingText}"
                                       Style="{StaticResource AppBodyText}" />
                            </VerticalStackLayout>
                        </Grid>
                    </material:ButtonView>

                    <BoxView Style="{StaticResource AppDivider}" />

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12"
                          Padding="4,12">
                        <Border Style="{StaticResource AppIconFrame}">
                            <Image Style="{StaticResource AppIcon}"
                                   Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static symbols:MaterialOutlined.Info}, Color={AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="3"
                                             VerticalOptions="Center">
                            <Label Text="{x:Static localization:AppResources.AppTitle}"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding ApplicationVersionText}"
                                   Style="{StaticResource AppBodyText}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
