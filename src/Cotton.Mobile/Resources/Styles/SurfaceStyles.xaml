<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Cotton.Mobile.Controls">
    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource M3LightPrimary}, Dark={StaticResource M3DarkPrimary}}" />
    </Style>

    <Style TargetType="ActivityIndicator" x:Key="M3StatusActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource M3LightPrimary}, Dark={StaticResource M3DarkPrimary}}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="WidthRequest" Value="{StaticResource M3FileInlineIconSize}" />
        <Setter Property="HeightRequest" Value="{StaticResource M3FileInlineIconSize}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{AppThemeBinding Light={StaticResource M3LightOutlineVariant}, Dark={StaticResource M3DarkOutlineVariant}}" />
        <Setter Property="SelectedIndicatorColor" Value="{AppThemeBinding Light={StaticResource M3LightPrimary}, Dark={StaticResource M3DarkAction}}" />
    </Style>

    <Style TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource M3LightOutlineVariant}, Dark={StaticResource M3DarkOutlineVariant}}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{StaticResource M3DefaultBorderCornerRadius}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="{StaticResource M3StrokeThin}" />
    </Style>

    <Style TargetType="Border" x:Key="M3SurfaceCard">
        <Setter Property="Stroke" Value="{StaticResource M3Transparent}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{StaticResource M3ContainerCornerRadius}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="{StaticResource M3StrokeNone}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightSurfaceContainer}, Dark={StaticResource M3DarkSurfaceContainer}}" />
    </Style>

    <Style TargetType="Border" x:Key="M3ContentCard" BasedOn="{StaticResource M3SurfaceCard}">
        <Setter Property="Padding" Value="{StaticResource M3ContentCardPadding}" />
    </Style>

    <Style TargetType="Border" x:Key="M3EmptyStateSurface">
        <Setter Property="Stroke" Value="{StaticResource M3Transparent}" />
        <Setter Property="StrokeThickness" Value="{StaticResource M3StrokeNone}" />
        <Setter Property="BackgroundColor" Value="{StaticResource M3Transparent}" />
        <Setter Property="Padding" Value="{StaticResource M3EmptyStateCardPadding}" />
    </Style>

    <Style TargetType="Border" x:Key="M3EmptyStateCompactSurface" BasedOn="{StaticResource M3EmptyStateSurface}">
        <Setter Property="Padding" Value="{StaticResource M3EmptyStateCompactCardPadding}" />
    </Style>

    <Style TargetType="Border" x:Key="M3EmptyStateIconFrame">
        <Setter Property="WidthRequest" Value="{StaticResource M3EmptyStateIconFrameSize}" />
        <Setter Property="HeightRequest" Value="{StaticResource M3EmptyStateIconFrameSize}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource M3LightTertiaryContainer}, Dark={StaticResource M3DarkTertiaryContainer}}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{StaticResource ShapeExtraLarge}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="{StaticResource M3StrokeThin}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightTertiaryContainer}, Dark={StaticResource M3DarkTertiaryContainer}}" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style TargetType="controls:IconView" x:Key="M3EmptyStateIcon">
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource M3LightOnTertiaryContainer}, Dark={StaticResource M3DarkOnTertiaryContainer}}" />
        <Setter Property="IconSize" Value="{StaticResource M3EmptyStateIconSize}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Border" x:Key="M3TonalPanel">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource M3LightOutlineVariant}, Dark={StaticResource M3DarkOutlineVariant}}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{StaticResource M3ContainerCornerRadius}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="{StaticResource M3StrokeThin}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightSurfaceContainer}, Dark={StaticResource M3DarkSurfaceContainer}}" />
    </Style>

    <Style TargetType="Border" x:Key="M3StatusPanel" BasedOn="{StaticResource M3TonalPanel}">
        <Setter Property="Padding" Value="{StaticResource M3FileStatusPanelPadding}" />
    </Style>

    <Style TargetType="Border" x:Key="M3LoadingStatusPanel" BasedOn="{StaticResource M3StatusPanel}">
        <Setter Property="Padding" Value="{StaticResource M3ContentCardPadding}" />
    </Style>

    <Style TargetType="Border" x:Key="M3AuthLoadingStatusPanel" BasedOn="{StaticResource M3LoadingStatusPanel}">
        <Setter Property="MaximumWidthRequest" Value="{StaticResource M3AuthPanelMaxWidth}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style TargetType="Grid" x:Key="M3LoadingStatusGrid">
        <Setter Property="ColumnSpacing" Value="{StaticResource Space12}" />
    </Style>

    <Style TargetType="Border" x:Key="M3LoadingIndicatorFrame">
        <Setter Property="WidthRequest" Value="{StaticResource M3ActionSheetRowIconFrameSize}" />
        <Setter Property="HeightRequest" Value="{StaticResource M3ActionSheetRowIconFrameSize}" />
        <Setter Property="Stroke" Value="{StaticResource M3Transparent}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{StaticResource ShapeFull}" />
            </Setter.Value>
        </Setter>
        <Setter Property="StrokeThickness" Value="{StaticResource M3StrokeNone}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightSurfaceContainerHigh}, Dark={StaticResource M3DarkSurfaceContainerHigh}}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="ActivityIndicator" x:Key="M3LoadingActivityIndicator" BasedOn="{StaticResource M3StatusActivityIndicator}">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="Label" x:Key="M3LoadingMessage" BasedOn="{StaticResource M3CardSupportingStrong}">
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
    </Style>


</ResourceDictionary>
