<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Cotton.Sdk" Version="$(CottonSdkVersion)" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
		<PackageReference Include="xunit.v3" Version="4.0.0" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Cotton.Mobile.Core\Cotton.Mobile.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Cotton.Mobile\Platforms\Android\AndroidJobExecution.cs" Link="Platforms\Android\AndroidJobExecution.cs" />
		<Compile Include="..\Cotton.Mobile\Services\CottonSessionService.cs" Link="Services\CottonSessionService.cs" />
		<Compile Include="..\Cotton.Mobile\Services\ICottonSessionService.cs" Link="Services\ICottonSessionService.cs" />
		<Compile Include="..\Cotton.Mobile\Services\CottonSessionResult.cs" Link="Services\CottonSessionResult.cs" />
		<Compile Include="..\Cotton.Mobile\Services\CottonSessionResultStatus.cs" Link="Services\CottonSessionResultStatus.cs" />
		<Compile Include="..\Cotton.Mobile\Services\CottonSessionDiagnosticLog.cs" Link="Services\CottonSessionDiagnosticLog.cs" />
		<Compile Include="..\Cotton.Mobile\Services\ICottonInstanceStore.cs" Link="Services\ICottonInstanceStore.cs" />
		<Compile Include="..\Cotton.Mobile\Services\ICottonPendingAppCodeSessionStore.cs" Link="Services\ICottonPendingAppCodeSessionStore.cs" />
		<Compile Include="..\Cotton.Mobile\Services\CottonPendingAppCodeSession.cs" Link="Services\CottonPendingAppCodeSession.cs" />
		<Compile Include="..\Cotton.Mobile\Services\ICottonAppCodeAuthorizationService.cs" Link="Services\ICottonAppCodeAuthorizationService.cs" />
		<Compile Include="..\Cotton.Mobile\Services\ICottonSessionNotificationService.cs" Link="Services\ICottonSessionNotificationService.cs" />
	</ItemGroup>

</Project>
