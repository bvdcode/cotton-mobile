<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Cotton.Mobile.Controls">
    <Style TargetType="controls:FilledButtonVisual" x:Key="M3FilledButtonVisual">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource M3LightOnAction}, Dark={StaticResource M3DarkOnAction}}" />
        <Setter Property="DisabledTextColor" Value="{AppThemeBinding Light={StaticResource M3LightOnSurfaceVariant}, Dark={StaticResource M3DarkOnSurfaceVariant}}" />
        <Setter Property="ButtonBackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightAction}, Dark={StaticResource M3DarkAction}}" />
        <Setter Property="PressedButtonBackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightActionPressed}, Dark={StaticResource M3DarkActionPressed}}" />
        <Setter Property="DisabledButtonBackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightSurfaceContainerHighest}, Dark={StaticResource M3DarkSurfaceContainerHighest}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource M3LightAction}, Dark={StaticResource M3DarkAction}}" />
        <Setter Property="DisabledBorderColor" Value="{StaticResource M3Transparent}" />
        <Setter Property="BorderWidth" Value="{StaticResource M3StrokeNone}" />
        <Setter Property="TextFontSize" Value="{StaticResource M3ButtonFontSize}" />
        <Setter Property="FontFamily" Value="{StaticResource M3FontFamilyMedium}" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="ButtonCornerRadius" Value="{StaticResource M3ButtonCornerRadius}" />
        <Setter Property="ContentPadding" Value="{StaticResource M3FilledButtonPadding}" />
    </Style>

    <Style TargetType="controls:FilledButton" x:Key="M3FilledButton">
        <Setter Property="MinimumHeightRequest" Value="{StaticResource M3ButtonMinSize}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource M3ButtonMinSize}" />
        <Setter Property="PressedOpacityMultiplier" Value="{StaticResource M3InteractionEnabledOpacity}" />
        <Setter Property="PressedScale" Value="{StaticResource M3InteractionPressedScale}" />
        <Setter Property="PressInDuration" Value="{StaticResource M3MotionPressInDuration}" />
        <Setter Property="PressOutDuration" Value="{StaticResource M3MotionPressOutDuration}" />
        <Setter Property="DisabledOpacity" Value="{StaticResource M3InteractionPrimaryDisabledOpacity}" />
    </Style>

    <Style TargetType="controls:FilledButton" x:Key="M3FullWidthFilledButton" BasedOn="{StaticResource M3FilledButton}">
        <Setter Property="HeightRequest" Value="{StaticResource M3FilledButtonHeight}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource M3FilledButtonHeight}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style TargetType="controls:FilledButton" x:Key="M3AuthFilledButton" BasedOn="{StaticResource M3FullWidthFilledButton}" />

    <Style TargetType="controls:FilledButton" x:Key="M3DialogFilledButton" BasedOn="{StaticResource M3FilledButton}">
        <Setter Property="MinimumWidthRequest" Value="{StaticResource M3DialogButtonMinWidth}" />
    </Style>

    <Style TargetType="controls:FilledButton" BasedOn="{StaticResource M3FilledButton}" />

    <Style TargetType="Border" x:Key="M3DialogSurface">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="MaximumWidthRequest" Value="{StaticResource M3DialogMaxWidth}" />
        <Setter Property="Margin" Value="{StaticResource M3DialogMargin}" />
        <Setter Property="StrokeThickness" Value="{StaticResource M3StrokeNone}" />
        <Setter Property="Shadow" Value="{StaticResource M3ShadowSoft}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{StaticResource M3DialogCornerRadius}" />
            </Setter.Value>
        </Setter>
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightSurfaceContainerHigh}, Dark={StaticResource M3DarkSurfaceContainerHigh}}" />
    </Style>

    <Style TargetType="Label" x:Key="M3DialogTitle" BasedOn="{StaticResource M3PanelTitle}">
        <Setter Property="MaxLines" Value="3" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style TargetType="Label" x:Key="M3DialogMessage" BasedOn="{StaticResource M3BodyMedium}">
        <Setter Property="MaxLines" Value="6" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <Style TargetType="VerticalStackLayout" x:Key="M3DialogStack">
        <Setter Property="Padding" Value="{StaticResource M3DialogPadding}" />
        <Setter Property="Spacing" Value="{StaticResource Space16}" />
    </Style>

    <Style TargetType="HorizontalStackLayout" x:Key="M3DialogButtonRow">
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="Spacing" Value="{StaticResource Space8}" />
    </Style>

    <Style TargetType="BoxView" x:Key="M3ModalScrim">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource M3LightScrim}, Dark={StaticResource M3DarkScrim}}" />
    </Style>

    <Style TargetType="ContentPage" x:Key="M3ModalPage">
        <Setter Property="BackgroundColor" Value="{StaticResource M3Transparent}" />
        <Setter Property="Padding" Value="{StaticResource M3NoPadding}" />
    </Style>

    <Style TargetType="ContentView" x:Key="M3TopAppBarSurface">
        <Setter Property="Padding" Value="{StaticResource M3TopAppBarPadding}" />
        <Setter Property="HeightRequest" Value="{StaticResource M3TopAppBarHeight}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightSurfaceBright}, Dark={StaticResource M3DarkSurfaceDim}}" />
    </Style>

    <Style TargetType="ContentView" x:Key="M3DarkTopAppBarSurface" BasedOn="{StaticResource M3TopAppBarSurface}">
        <Setter Property="BackgroundColor" Value="{StaticResource M3DarkSurfaceDim}" />
    </Style>

    <Style TargetType="Grid" x:Key="M3TopAppBarContentGrid">
        <Setter Property="ColumnSpacing" Value="{StaticResource Space4}" />
        <Setter Property="HeightRequest" Value="{StaticResource TouchTarget}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="HorizontalStackLayout" x:Key="M3TopAppBarActionCluster">
        <Setter Property="Spacing" Value="{StaticResource Space4}" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="HorizontalStackLayout" x:Key="M3LegalFooterBar">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="controls:IconButton" x:Key="M3IconButtonBase">
        <Setter Property="PressedOpacityMultiplier" Value="{StaticResource M3InteractionEnabledOpacity}" />
        <Setter Property="PressedScale" Value="{StaticResource M3InteractionPressedScale}" />
        <Setter Property="PressInDuration" Value="{StaticResource M3MotionPressInDuration}" />
        <Setter Property="PressOutDuration" Value="{StaticResource M3MotionPressOutDuration}" />
        <Setter Property="DisabledOpacity" Value="{StaticResource M3InteractionDisabledOpacity}" />
        <Setter Property="BorderWidth" Value="{StaticResource M3StrokeThin}" />
    </Style>

    <Style TargetType="controls:IconButton" x:Key="M3TopAppBarIconButton" BasedOn="{StaticResource M3IconButtonBase}">
        <Setter Property="ButtonSize" Value="{StaticResource TouchTarget}" />
        <Setter Property="IconSize" Value="{StaticResource M3TopAppBarIconSize}" />
        <Setter Property="ButtonCornerRadius" Value="{StaticResource ShapeExtraLarge}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource M3LightOnSurface}, Dark={StaticResource M3DarkOnSurface}}" />
        <Setter Property="ButtonBackgroundColor" Value="{StaticResource M3Transparent}" />
        <Setter Property="PressedButtonBackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightSurfaceContainerHigh}, Dark={StaticResource M3DarkSurfaceContainerHigh}}" />
        <Setter Property="BorderColor" Value="{StaticResource M3Transparent}" />
    </Style>

    <Style TargetType="controls:IconButton" x:Key="M3DarkTopAppBarIconButton" BasedOn="{StaticResource M3TopAppBarIconButton}">
        <Setter Property="IconColor" Value="{StaticResource M3DarkOnSurface}" />
        <Setter Property="ButtonBackgroundColor" Value="{StaticResource M3Transparent}" />
        <Setter Property="PressedButtonBackgroundColor" Value="{StaticResource M3DarkSurfaceContainerHigh}" />
        <Setter Property="BorderColor" Value="{StaticResource M3Transparent}" />
    </Style>

    <Style TargetType="controls:IconButton" x:Key="M3DefaultIconButton" BasedOn="{StaticResource M3IconButtonBase}">
        <Setter Property="ButtonSize" Value="{StaticResource M3IconButtonSize}" />
        <Setter Property="IconSize" Value="{StaticResource M3IconButtonIconSize}" />
        <Setter Property="ButtonCornerRadius" Value="{StaticResource ShapeExtraLarge}" />
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource M3LightOnSurfaceVariant}, Dark={StaticResource M3DarkOnSurfaceVariant}}" />
        <Setter Property="ButtonBackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightSurfaceContainerLow}, Dark={StaticResource M3DarkSurfaceContainerLow}}" />
        <Setter Property="PressedButtonBackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightSurfaceContainerHigh}, Dark={StaticResource M3DarkSurfaceContainerHigh}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource M3LightOutlineVariant}, Dark={StaticResource M3DarkOutlineVariant}}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style TargetType="controls:IconButton" x:Key="M3PrimaryIconButton" BasedOn="{StaticResource M3DefaultIconButton}">
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource M3LightOnActionContainer}, Dark={StaticResource M3DarkOnActionContainer}}" />
        <Setter Property="ButtonBackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightActionContainer}, Dark={StaticResource M3DarkActionContainer}}" />
        <Setter Property="PressedButtonBackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightActionContainerPressed}, Dark={StaticResource M3DarkActionContainerPressed}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource M3LightActionContainer}, Dark={StaticResource M3DarkActionContainer}}" />
    </Style>

    <Style TargetType="controls:IconButton" x:Key="M3DestructiveIconButton" BasedOn="{StaticResource M3DefaultIconButton}">
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource M3LightError}, Dark={StaticResource M3DarkError}}" />
    </Style>

    <Style TargetType="controls:IconButton" x:Key="M3EmptyStateActionIconButton" BasedOn="{StaticResource M3PrimaryIconButton}">
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style TargetType="controls:IconButton" BasedOn="{StaticResource M3DefaultIconButton}" />

    <Style TargetType="controls:IconView">
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource M3LightOnSurfaceVariant}, Dark={StaticResource M3DarkOnSurfaceVariant}}" />
        <Setter Property="IconSize" Value="{StaticResource M3FileInlineIconSize}" />
    </Style>

    <Style TargetType="controls:NavigationBarItem" x:Key="M3NavigationBarItem">
        <Setter Property="PressedOpacityMultiplier" Value="{StaticResource M3InteractionEnabledOpacity}" />
        <Setter Property="PressedScale" Value="{StaticResource M3InteractionPressedScale}" />
        <Setter Property="PressInDuration" Value="{StaticResource M3MotionPressInDuration}" />
        <Setter Property="PressOutDuration" Value="{StaticResource M3MotionPressOutDuration}" />
        <Setter Property="DisabledOpacity" Value="{StaticResource M3InteractionDisabledOpacity}" />
    </Style>

    <Style TargetType="controls:NavigationBarItemVisual" x:Key="M3NavigationBarItemVisual">
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource M3LightOnSurfaceVariant}, Dark={StaticResource M3DarkOnSurfaceVariant}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource M3LightOnSurfaceVariant}, Dark={StaticResource M3DarkOnSurfaceVariant}}" />
        <Setter Property="FillColor" Value="{StaticResource M3Transparent}" />
        <Setter Property="PressedFillColor" Value="{AppThemeBinding Light={StaticResource M3LightSurfaceContainerHigh}, Dark={StaticResource M3DarkSurfaceContainerHigh}}" />
        <Setter Property="BorderColor" Value="{StaticResource M3Transparent}" />
        <Setter Property="StrokeThickness" Value="{StaticResource M3StrokeThin}" />
        <Setter Property="Padding" Value="{StaticResource M3NavigationBarItemPadding}" />
        <Setter Property="ContentSpacing" Value="{StaticResource M3NavigationBarContentSpacing}" />
        <Setter Property="IconSize" Value="{StaticResource M3NavigationBarIconSize}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="{StaticResource ShapeExtraLarge}" />
            </Setter.Value>
        </Setter>
        <Setter Property="HeightRequest" Value="{StaticResource M3NavigationBarHeight}" />
        <Setter Property="TextFontSize" Value="{StaticResource M3NavigationBarLabelFontSize}" />
        <Setter Property="TextFontFamily" Value="{StaticResource M3FontFamilyMedium}" />
        <Setter Property="TextFontAttributes" Value="None" />
    </Style>

    <Style TargetType="controls:NavigationBarItem" BasedOn="{StaticResource M3NavigationBarItem}" />

    <Style TargetType="controls:NavigationBarItemVisual" x:Key="M3NavigationBarItemVisualSelected" BasedOn="{StaticResource M3NavigationBarItemVisual}">
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource M3LightOnAction}, Dark={StaticResource M3DarkOnAction}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource M3LightOnAction}, Dark={StaticResource M3DarkOnAction}}" />
        <Setter Property="FillColor" Value="{AppThemeBinding Light={StaticResource M3LightAction}, Dark={StaticResource M3DarkAction}}" />
        <Setter Property="PressedFillColor" Value="{AppThemeBinding Light={StaticResource M3LightActionPressed}, Dark={StaticResource M3DarkActionPressed}}" />
        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource M3LightAction}, Dark={StaticResource M3DarkAction}}" />
    </Style>

    <Style TargetType="controls:NavigationBarItemVisual" x:Key="M3NavigationBarItemVisualUnselected" BasedOn="{StaticResource M3NavigationBarItemVisual}">
        <Setter Property="IconColor" Value="{AppThemeBinding Light={StaticResource M3LightOnSurfaceVariant}, Dark={StaticResource M3DarkOnSurfaceVariant}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource M3LightOnSurfaceVariant}, Dark={StaticResource M3DarkOnSurfaceVariant}}" />
        <Setter Property="FillColor" Value="{StaticResource M3Transparent}" />
        <Setter Property="PressedFillColor" Value="{AppThemeBinding Light={StaticResource M3LightSurfaceContainerHigh}, Dark={StaticResource M3DarkSurfaceContainerHigh}}" />
        <Setter Property="BorderColor" Value="{StaticResource M3Transparent}" />
    </Style>

    <Style TargetType="controls:TextAction" x:Key="M3FooterTextAction">
        <Setter Property="PressedOpacityMultiplier" Value="{StaticResource M3InteractionEnabledOpacity}" />
        <Setter Property="PressedScale" Value="{StaticResource M3InteractionPressedScale}" />
        <Setter Property="PressInDuration" Value="{StaticResource M3MotionPressInDuration}" />
        <Setter Property="PressOutDuration" Value="{StaticResource M3MotionPressOutDuration}" />
        <Setter Property="DisabledOpacity" Value="{StaticResource M3InteractionDisabledOpacity}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource M3LightOnSurfaceVariant}, Dark={StaticResource M3DarkOnSurfaceVariant}}" />
        <Setter Property="TextFontSize" Value="{StaticResource M3FooterLinkFontSize}" />
        <Setter Property="TextFontFamily" Value="{StaticResource M3FontFamilyMedium}" />
        <Setter Property="ContentPadding" Value="{StaticResource M3FooterLinkPadding}" />
        <Setter Property="ButtonBackgroundColor" Value="{StaticResource M3Transparent}" />
        <Setter Property="PressedButtonBackgroundColor" Value="{AppThemeBinding Light={StaticResource M3LightSurfaceContainerHigh}, Dark={StaticResource M3DarkSurfaceContainerHigh}}" />
        <Setter Property="ButtonCornerRadius" Value="{StaticResource ShapeExtraLarge}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource M3FooterLinkMinHeight}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource M3ControlMinSize}" />
    </Style>

    <Style TargetType="controls:TextAction" BasedOn="{StaticResource M3FooterTextAction}" />

    <Style TargetType="controls:TextAction" x:Key="M3AuthServerTextAction" BasedOn="{StaticResource M3FooterTextAction}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource M3LightPrimary}, Dark={StaticResource M3DarkAction}}" />
        <Setter Property="TextFontSize" Value="{StaticResource M3ButtonFontSize}" />
        <Setter Property="ContentPadding" Value="{StaticResource M3FooterLinkPadding}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource M3ButtonMinSize}" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style TargetType="controls:TextAction" x:Key="M3DialogTextAction" BasedOn="{StaticResource M3FooterTextAction}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource M3LightOnSurface}, Dark={StaticResource M3DarkOnSurface}}" />
        <Setter Property="TextFontSize" Value="{StaticResource M3ButtonFontSize}" />
        <Setter Property="ContentPadding" Value="{StaticResource M3DialogTextButtonPadding}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource M3ButtonMinSize}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource M3DialogButtonMinWidth}" />
    </Style>


</ResourceDictionary>
