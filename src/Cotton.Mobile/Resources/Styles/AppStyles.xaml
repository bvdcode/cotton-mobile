<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Thickness x:Key="AppPagePadding">20,12,20,24</Thickness>
    <Thickness x:Key="AppCardPadding">16</Thickness>
    <Thickness x:Key="AppTopBarPadding">12,8</Thickness>
    <Thickness x:Key="AppCardActionPadding">12,14</Thickness>
    <x:Double x:Key="AppContentMaximumWidth">720</x:Double>
    <x:Double x:Key="AppTouchTargetSize">48</x:Double>
    <x:Double x:Key="AppNavigationItemHeight">64</x:Double>

    <!-- Compose with an existing class, e.g. StyleClass="TextButton, TouchTarget". -->
    <Style TargetType="Button" Class="TouchTarget" ApplyToDerivedTypes="True">
        <Setter Property="MinimumHeightRequest" Value="{StaticResource AppTouchTargetSize}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource AppTouchTargetSize}" />
    </Style>

    <!-- Taller than a plain touch target so the icon and its label both fit. -->
    <Style TargetType="Button" Class="NavigationBarItem" ApplyToDerivedTypes="True">
        <Setter Property="MinimumHeightRequest" Value="{StaticResource AppNavigationItemHeight}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource AppTouchTargetSize}" />
    </Style>

    <!-- FlexLayout measures children from content, so padding supplies the touch target
         while still allowing the button to grow with accessible font scaling. -->
    <Style TargetType="Button" Class="CardAction" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="{StaticResource AppCardActionPadding}" />
    </Style>

    <Style TargetType="Button" Class="DisabledOpacity" ApplyToDerivedTypes="True">
        <Style.Triggers>
            <Trigger TargetType="Button"
                     Property="IsEnabled"
                     Value="False">
                <Setter Property="Opacity" Value="0.38" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppScreen" TargetType="Grid">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Background}, Dark={StaticResource BackgroundDark}}" />
    </Style>

    <Style x:Key="AppTopBar" TargetType="Grid">
        <Setter Property="Padding" Value="{StaticResource AppTopBarPadding}" />
        <Setter Property="ColumnSpacing" Value="4" />
        <Setter Property="MinimumHeightRequest" Value="64" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
    </Style>

    <Style x:Key="AppScrollableContent" TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="{StaticResource AppPagePadding}" />
        <Setter Property="Spacing" Value="16" />
        <Setter Property="MaximumWidthRequest" Value="{StaticResource AppContentMaximumWidth}" />
        <Setter Property="HorizontalOptions" Value="Fill" />
    </Style>

    <Style x:Key="AppCard" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource AppCardPadding}" />
        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource Outline}, Dark={StaticResource OutlineDark}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="20" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppStatusCard" TargetType="Border" BasedOn="{StaticResource AppCard}">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource PrimaryContainer}, Dark={StaticResource PrimaryContainerDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <Style x:Key="AppTopBarTitle" TargetType="Label">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <Style x:Key="AppScreenTitle" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="AppSectionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="AppBodyText" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource OnSurfaceVariant}, Dark={StaticResource OnSurfaceVariantDark}}" />
    </Style>

    <Style x:Key="AppCaptionText" TargetType="Label" BasedOn="{StaticResource AppBodyText}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="AppIcon" TargetType="Image">
        <Setter Property="WidthRequest" Value="24" />
        <Setter Property="HeightRequest" Value="24" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="AppIconFrame" TargetType="Border">
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource SecondaryContainer}, Dark={StaticResource SecondaryContainerDark}}" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same footprint as AppIconFrame, but full-bleed and round so a photo fills it. -->
    <Style x:Key="AppAvatarFrame" TargetType="Border" BasedOn="{StaticResource AppIconFrame}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <Ellipse />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppNavigationBar" TargetType="Grid">
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="ColumnSpacing" Value="8" />
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}" />
    </Style>

    <LinearItemsLayout x:Key="AppVerticalCardList"
                       Orientation="Vertical"
                       ItemSpacing="12" />
</ResourceDictionary>
