<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:localization="clr-namespace:Cotton.Mobile.Resources.Localization"
             xmlns:services="clr-namespace:Cotton.Mobile.Services;assembly=Cotton.Mobile.Core"
             xmlns:symbols="clr-namespace:UraniumUI.Icons.MaterialSymbols;assembly=UraniumUI.Icons.MaterialSymbols"
             xmlns:viewModels="clr-namespace:Cotton.Mobile.ViewModels"
             x:Class="Cotton.Mobile.SyncDashboardView"
             x:Name="SyncViewRoot"
             x:DataType="viewModels:SyncSettingsViewModel">

    <Grid RowDefinitions="Auto,*"
          Style="{StaticResource AppScreen}">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
              Style="{StaticResource AppTopBar}">
            <Label Text="{x:Static localization:AppResources.SyncTitle}"
                   Style="{StaticResource AppTopBarTitle}" />

            <Button Grid.Column="1"
                    Command="{Binding AddRootCommand}"
                    SemanticProperties.Description="{x:Static localization:AppResources.AddSyncFolderDescription}"
                    StyleClass="TextButton, TouchTarget">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialOutlined"
                                     Glyph="{x:Static symbols:MaterialOutlined.Add}"
                                     Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Button.ImageSource>
            </Button>

            <Button Grid.Column="2"
                    Command="{Binding RunAllCommand}"
                    IsVisible="{Binding IsRunAllVisible}"
                    SemanticProperties.Description="{x:Static localization:AppResources.RunAllSyncFoldersDescription}"
                    StyleClass="TextButton, TouchTarget">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialOutlined"
                                     Glyph="{x:Static symbols:MaterialOutlined.Play_arrow}"
                                     Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Button.ImageSource>
            </Button>

            <Button Grid.Column="3"
                    Command="{Binding LoadCommand}"
                    SemanticProperties.Description="{x:Static localization:AppResources.RefreshSyncFoldersDescription}"
                    StyleClass="TextButton, TouchTarget">
                <Button.ImageSource>
                    <FontImageSource FontFamily="MaterialOutlined"
                                     Glyph="{x:Static symbols:MaterialOutlined.Refresh}"
                                     Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </Button.ImageSource>
            </Button>
        </Grid>

        <Grid Grid.Row="1"
              RowDefinitions="Auto,*"
              Padding="{StaticResource AppPagePadding}"
              RowSpacing="16"
              MaximumWidthRequest="{StaticResource AppContentMaximumWidth}"
              HorizontalOptions="Fill">
            <Label Text="{Binding HeaderSupportingText}"
                   IsVisible="{Binding IsHeaderSupportingTextVisible}"
                   Style="{StaticResource AppBodyText}"
                   VerticalOptions="Center" />

            <VerticalStackLayout Grid.Row="1"
                                 Spacing="16"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center"
                                 IsVisible="{Binding IsEmptyVisible}">
                <Border Style="{StaticResource AppIconFrame}"
                        HorizontalOptions="Center">
                    <Image Style="{StaticResource AppIcon}"
                           Source="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static symbols:MaterialOutlined.Folder}, Color={AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}}" />
                </Border>
                <Label Text="{x:Static localization:AppResources.NoSyncFoldersTitle}"
                       Style="{StaticResource AppSectionTitle}"
                       HorizontalTextAlignment="Center" />
                <Label Text="{x:Static localization:AppResources.NoSyncFoldersBody}"
                       Style="{StaticResource AppBodyText}"
                       HorizontalTextAlignment="Center" />
                <Button Text="{x:Static localization:AppResources.AddSyncFolderDescription}"
                        Command="{Binding AddRootCommand}"
                        StyleClass="FilledButton, TouchTarget" />
            </VerticalStackLayout>

            <CollectionView Grid.Row="1"
                            IsVisible="{Binding IsListVisible}"
                            ItemsSource="{Binding Roots}"
                            ItemSizingStrategy="MeasureAllItems">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="0" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="services:CottonSyncRootListItem">
                        <Grid RowDefinitions="Auto,Auto">
                            <VerticalStackLayout Padding="4,10"
                                                 Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="12">
                                    <Border Style="{StaticResource AppIconFrame}">
                                        <Image Style="{StaticResource AppIcon}">
                                            <Image.Source>
                                                <FontImageSource FontFamily="MaterialOutlined"
                                                                 Glyph="{x:Static symbols:MaterialOutlined.Folder}"
                                                                 Color="{AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}" />
                                            </Image.Source>
                                            <Image.Triggers>
                                                <DataTrigger TargetType="Image"
                                                             Binding="{Binding IsAttentionVisible}"
                                                             Value="True">
                                                    <Setter Property="Source"
                                                            Value="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static symbols:MaterialOutlined.Error}, Color={AppThemeBinding Light={StaticResource OnSecondaryContainer}, Dark={StaticResource OnSecondaryContainerDark}}}" />
                                                </DataTrigger>
                                            </Image.Triggers>
                                        </Image>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1"
                                                         Spacing="3"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding DisplayPathText}"
                                               FontAttributes="Bold"
                                               Style="{StaticResource AppBodyText}"
                                               LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Spacing="6">
                                            <HorizontalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.RootActionCommand, Source={x:Reference SyncViewRoot}}"
                                                                      CommandParameter="{Binding FailureDetailsAction}" />
                                            </HorizontalStackLayout.GestureRecognizers>
                                            <ActivityIndicator IsRunning="{Binding IsRunning}"
                                                               IsVisible="{Binding IsRunning}"
                                                               WidthRequest="18"
                                                               HeightRequest="18"
                                                               Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <Label Text="{Binding StatusText}"
                                                   Style="{StaticResource AppCaptionText}"
                                                   VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label"
                                                                 Binding="{Binding CanShowFailureDetails}"
                                                                 Value="True">
                                                        <Setter Property="TextDecorations"
                                                                Value="Underline" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2"
                                                         Spacing="0"
                                                         VerticalOptions="Center">
                                        <Button Command="{Binding BindingContext.RootActionCommand, Source={x:Reference SyncViewRoot}}"
                                                CommandParameter="{Binding PrimaryAction}"
                                                IsVisible="{Binding CanUsePrimaryAction}"
                                                SemanticProperties.Description="{Binding PrimaryActionText}"
                                                StyleClass="TextButton, TouchTarget">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialOutlined"
                                                                 Glyph="{x:Static symbols:MaterialOutlined.Play_arrow}"
                                                                 Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            </Button.ImageSource>
                                            <Button.Triggers>
                                                <DataTrigger TargetType="Button"
                                                             Binding="{Binding CanReconnect}"
                                                             Value="True">
                                                    <Setter Property="ImageSource"
                                                            Value="{FontImageSource FontFamily=MaterialOutlined, Glyph={x:Static symbols:MaterialOutlined.Folder_open}, Color={AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}}" />
                                                </DataTrigger>
                                            </Button.Triggers>
                                        </Button>

                                        <Button Command="{Binding BindingContext.RootActionCommand, Source={x:Reference SyncViewRoot}}"
                                                CommandParameter="{Binding PauseAction}"
                                                IsVisible="{Binding CanPauseSync}"
                                                SemanticProperties.Description="{Binding PauseSyncActionText}"
                                                StyleClass="TextButton, TouchTarget">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialOutlined"
                                                                 Glyph="{x:Static symbols:MaterialOutlined.Pause}"
                                                                 Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            </Button.ImageSource>
                                        </Button>

                                        <Button Command="{Binding BindingContext.RootActionCommand, Source={x:Reference SyncViewRoot}}"
                                                CommandParameter="{Binding ResumeAction}"
                                                IsVisible="{Binding CanResumeSync}"
                                                SemanticProperties.Description="{Binding ResumeSyncActionText}"
                                                StyleClass="TextButton, TouchTarget">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialOutlined"
                                                                 Glyph="{x:Static symbols:MaterialOutlined.Resume}"
                                                                 Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            </Button.ImageSource>
                                        </Button>

                                        <Button Command="{Binding BindingContext.RootActionCommand, Source={x:Reference SyncViewRoot}}"
                                                CommandParameter="{Binding StopAction}"
                                                IsVisible="{Binding CanStopSync}"
                                                SemanticProperties.Description="{Binding StopSyncActionText}"
                                                StyleClass="TextButton, TouchTarget">
                                            <Button.ImageSource>
                                                <FontImageSource FontFamily="MaterialOutlined"
                                                                 Glyph="{x:Static symbols:MaterialOutlined.Stop_circle}"
                                                                 Color="{AppThemeBinding Light={StaticResource Error}, Dark={StaticResource ErrorDark}}" />
                                            </Button.ImageSource>
                                        </Button>
                                    </VerticalStackLayout>
                                </Grid>

                                <ProgressBar Progress="{Binding ProgressValue}"
                                             IsVisible="{Binding IsProgressDeterminate}"
                                             ProgressColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                            </VerticalStackLayout>
                            <BoxView Grid.Row="1"
                                     Style="{StaticResource AppDivider}"
                                     IsVisible="{Binding IsDividerVisible}"
                                     />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentView>
